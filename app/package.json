{
  "name": "@album-blender/app",
  "version": "0.1.0",
  "private": true,
  "description": "The Album Blender for iPhone and Android (F78, ADR-0022): Expo, React Native and TypeScript over the shared core in ../shared. The skeleton: sign in, the list of series, the golden self-test.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint . --max-warnings 0",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios --clear --source-maps",
    "bundle:android": "expo export --platform android --output-dir dist/android --clear --source-maps",
    "scan:bundles": "node ../scripts/app-bundle-scan.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run bundle:ios && npm run bundle:android && npm run scan:bundles"
  },
  "dependencies": {
    "@album-blender/shared": "*",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-firebase/app": "^27.1.1",
    "@react-native-firebase/auth": "^27.1.1",
    "@react-native-firebase/firestore": "^27.1.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "posthog-react-native": "^4.87.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  }
}
