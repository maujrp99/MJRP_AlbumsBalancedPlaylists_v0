{
    "name": "mjrp-playlist-generator",
    "version": "3.19.0",
    "description": "The Album Blender (Album Blender V0): the site that blends ranked albums into balanced playlists - vanilla JS built with Vite; the server is in server/",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "lint": "eslint .",
        "deploy:site": "./scripts/deploy-site.sh",
        "deploy:site:dry-run": "./scripts/deploy-site.sh --dry-run",
        "deploy:server": "./scripts/deploy-server.sh",
        "deploy:server:dry-run": "./scripts/deploy-server.sh --dry-run"
    },
    "keywords": [
        "playlist",
        "music",
        "curation",
        "acclaim"
    ],
    "author": "maujrp99",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@vitest/coverage-v8": "^1.1.0",
        "@vitest/ui": "^1.1.0",
        "dotenv": "^17.2.3",
        "eslint": "^9.39.2",
        "espree": "^10.4.0",
        "globals": "^16.5.0",
        "jsdom": "^23.0.1",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.19",
        "vite": "^5.0.10",
        "vitest": "^1.1.0"
    },
    "dependencies": {
        "axios": "^1.13.2",
        "firebase": "^10.14.1",
        "posthog-js": "1.447.0",
        "sortablejs": "^1.15.6"
    }
}
