# Copy this file to .env and fill in values
AI_API_KEY=your_api_key_here
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/<MODEL_NAME>:generateContent
PORT=3000

# Frontend (read by Vite at build time). The Spotify app's Client ID (public value, from the
# Spotify developer dashboard). Without it the Spotify connection breaks, in dev and in the deploy build.
# scripts/deploy-site.sh copies this file into the clean copy of main it builds from, and refuses to
# deploy when the built scripts do not contain this value.
VITE_SPOTIFY_CLIENT_ID=

# The measurement of use (F77; read by Vite at build time, public values: they only let the site
# send events to the project). With VITE_POSTHOG_KEY empty the site measures nothing and never
# downloads the measurement library. The key is the PostHog project's API key (Project settings).
# VITE_POSTHOG_HOST: the ingestion host of the project's cloud; empty means the EU cloud,
# https://eu.i.posthog.com (the US cloud is https://us.i.posthog.com).
# VITE_USAGE_MEASUREMENT=off builds a site that measures nothing, with the key or without it.
# On one browser, with no new build: localStorage.setItem('mjrp.usage', 'off') in the console.
# scripts/deploy-site.sh says which way the site is built, and refuses to deploy a key that is not
# in the built scripts.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_USAGE_MEASUREMENT=
